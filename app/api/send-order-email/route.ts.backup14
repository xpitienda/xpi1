import { NextRequest, NextResponse } from 'next/server';
import nodemailer from 'nodemailer';

export async function POST(request: NextRequest) {
  try {
    const body = await request.json();
    const customerInfo = body.customerInfo;
    const cart = body.cart;
    const total = body.total;

    console.log('Enviando email...');
    console.log('Cliente:', customerInfo.name);
    console.log('Total:', total);

    const transporter = nodemailer.createTransport({
      service: 'gmail',
      auth: {
        user: process.env.EMAIL_USER,
        pass: process.env.EMAIL_PASS,
      },
    });

    let productosTexto = '';
    for (let i = 0; i < cart.length; i++) {
      const item = cart[i];
      const sub = item.price * item.quantity;
      productosTexto += item.name + ' x' + item.quantity;
      productosTexto += ' = $' + sub.toLocaleString('es-CO') + '\n';
    }

    const fecha = new Date().toLocaleString('es-CO');
    const totalTxt = total.toLocaleString('es-CO');

    const html = '<h1>Nuevo Pedido - XPI Tienda</h1>' +
      '<h2>Fecha: ' + fecha + '</h2>' +
      '<h2>Cliente: ' + customerInfo.name + '</h2>' +
      '<p>Telefono: ' + customerInfo.phone + '</p>' +
      '<p>Direccion: ' + customerInfo.address + '</p>' +
      (customerInfo.city ? '<p>Ciudad: ' + customerInfo.city + '</p>' : '') +
      '<h2>Productos:</h2>' +
      '<pre>' + productosTexto + '</pre>' +
      '<h2>TOTAL: $' + totalTxt + '</h2>';

    const subject = 'Nuevo Pedido - ' + customerInfo.name;
    const to = process.env.ORDER_EMAIL_DESTINO || 'xpitienda@gmail.com';

    const info = await transporter.sendMail({
      from: process.env.EMAIL_USER,
      to: to,
      subject: subject,
      html: html,
    });

    console.log('Email enviado:', info.messageId);
    return NextResponse.json({ 
      success: true, 
      message: 'OK', 
      id: info.messageId 
    });

  } catch (error: any) {
    console.error('Error:', error.message);
    return NextResponse.json({ 
      success: false, 
      message: error.message 
    }, { status: 500 });
  }
}